generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  metaAccounts  MetaAccount[]
  products      Product[]
  sales         Sale[]
  utmLinks      UTMLink[]
  costs         Cost[]
  costCategories CostCategory[]
  alerts        Alert[]
  notifications Notification[]
}

model MetaAccount {
  id              String   @id @default(cuid())
  userId          String
  accountId       String
  accountName     String
  accessToken     String
  appId           String?
  appSecret       String?
  status          String   @default("active")
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns       Campaign[]

  @@unique([userId, accountId])
}

model Campaign {
  id              String   @id @default(cuid())
  metaAccountId   String
  campaignId      String
  name            String
  status          String
  objective       String?
  dailyBudget     Float?
  lifetimeBudget  Float?
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cpm             Float    @default(0)
  cpc             Float    @default(0)
  ctr             Float    @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  metaAccount     MetaAccount @relation(fields: [metaAccountId], references: [id], onDelete: Cascade)
  adSets          AdSet[]

  @@unique([metaAccountId, campaignId])
}

model AdSet {
  id              String   @id @default(cuid())
  campaignId      String
  adSetId         String
  name            String
  status          String
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cpm             Float    @default(0)
  cpc             Float    @default(0)
  ctr             Float    @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign        Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  ads             Ad[]

  @@unique([campaignId, adSetId])
}

model Ad {
  id              String   @id @default(cuid())
  adSetId         String
  adId            String
  name            String
  status          String
  spend           Float    @default(0)
  impressions     Int      @default(0)
  clicks          Int      @default(0)
  cpm             Float    @default(0)
  cpc             Float    @default(0)
  ctr             Float    @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  adSet           AdSet    @relation(fields: [adSetId], references: [id], onDelete: Cascade)

  @@unique([adSetId, adId])
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  price       Float
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales       Sale[]
  utmLinks    UTMLink[]
}

model Sale {
  id                String   @id @default(cuid())
  userId            String
  productId         String?
  transactionId     String   @unique
  platform          String   @default("blackcatpay")
  status            String
  amount            Float
  currency          String   @default("BRL")
  customerName      String?
  customerEmail     String?
  customerPhone     String?
  paymentMethod     String?

  utmSource         String?
  utmMedium         String?
  utmCampaign       String?
  utmContent        String?
  utmTerm           String?

  rawPayload        String?  @db.Text

  saleDate          DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product? @relation(fields: [productId], references: [id])

  @@index([userId, status])
  @@index([userId, saleDate])
  @@index([utmSource, utmMedium, utmCampaign])
}

model UTMLink {
  id              String   @id @default(cuid())
  userId          String
  productId       String?
  baseUrl         String
  utmSource       String
  utmMedium       String
  utmCampaign     String
  utmContent      String?
  utmTerm         String?
  fullUrl         String   @db.Text
  clicks          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id])
}

model CostCategory {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  costs       Cost[]

  @@unique([userId, name])
}

model Cost {
  id              String   @id @default(cuid())
  userId          String
  categoryId      String?
  name            String
  amount          Float
  type            String
  recurrence      String?
  isPercentage    Boolean  @default(false)
  percentageValue Float?
  active          Boolean  @default(true)
  startDate       DateTime?
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        CostCategory? @relation(fields: [categoryId], references: [id])
}

model Alert {
  id          String   @id @default(cuid())
  userId      String
  name        String
  metric      String
  condition   String
  value       Float
  active      Boolean  @default(true)
  lastTriggered DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  title       String
  message     String
  type        String
  read        Boolean  @default(false)
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model WebhookLog {
  id          String   @id @default(cuid())
  platform    String
  event       String
  payload     String   @db.Text
  status      String
  errorMessage String?
  processedAt DateTime @default(now())

  @@index([platform, processedAt])
}
